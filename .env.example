FIRECRAWL_KEY="YOUR_KEY"
# If you want to use your self-hosted Firecrawl, add the following below:
# FIRECRAWL_BASE_URL="http://localhost:3002"
# FIRECRAWL_CONCURRENCY="2"
# FIRECRAWL_TIMEOUT="30000"  # Scrape timeout in ms (default 30s, increase for slow sites)

OPENAI_KEY="YOUR_KEY"
CONTEXT_SIZE="128000"


OPEN_ROUTER_KEY="YOUR_KEY"

# NVIDIA API (build.nvidia.com)
# NVIDIA_API_KEY="YOUR_KEY"
# If you want to use other OpenAI compatible API, add the following below:
# OPENAI_ENDPOINT="http://localhost:11434/v1"
# CUSTOM_MODEL="llama3.1"

# If you want to use fireworks.ai's DeepSeek R1 model:
# FIREWORKS_KEY="YOUR_KEY"

# AWS Bedrock Configuration
# Set AWS_BEDROCK_ENABLED=true and configure AWS credentials via:
# - Environment variables (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY)
# - AWS credentials file (~/.aws/credentials)
# - IAM role (if running on AWS infrastructure)
# AWS_BEDROCK_ENABLED=true
# AWS_REGION=us-east-1
# AWS_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# AWS_BEDROCK_TIMEOUT=300  # Read timeout in seconds (default 5 min, increase for long reports)
# AWS_BEDROCK_MAX_TOKENS=16384  # Max output tokens (default 16k, increase for longer reports)
# Available Bedrock models:
# - anthropic.claude-3-5-sonnet-20241022-v2:0 (default, recommended)
# - anthropic.claude-3-5-haiku-20241022-v1:0 (faster, cheaper)
# - anthropic.claude-3-opus-20240229-v1:0 (most capable)
# - anthropic.claude-3-sonnet-20240229-v1:0
# - amazon.titan-text-premier-v1:0
# - meta.llama3-1-70b-instruct-v1:0

USE_RERANKING=true
DEDUP_THRESHOLD=0.9
MIN_YEAR=2020